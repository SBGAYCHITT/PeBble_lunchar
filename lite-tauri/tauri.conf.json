{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pebble Launcher Lite",
  "version": "4.2.0",
  "identifier": "com.sbgaychitt.pebblelauncher.lite",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pebble Launcher Lite",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    }
  }
}

# ===== 依赖（npm install 自动生成，约 441MB，绝不传） =====
node_modules/

# ===== 构建产物（npm run dist 生成，约 334MB；SignPath 从本地 zip 签名，不进仓库） =====
dist/
# 备用输出目录：electron-builder 的 emptyDir 会被沙箱的批量删除守卫拦（>50 项），
# 这时改用 --config.directories.output=dist2 重建，再 PL_SRC=dist2/win-unpacked 打包
dist2/

# ===== 本地开发证书配置（含本机证书指纹/路径，不进公开仓库） =====
.signing/

# ===== NSIS 脚本：由 make-exe.js 从 package.json 现生成，版本号/OutFile 路径都是本机的 =====
tools/pl.nsi

# ===== 临时 / 调试产物 =====
*.bak
auto-test-log*.txt
javaprobe.txt
_pages_keys.json
shot-*.png

# ===== 日志 =====
*.log

# ===== 系统 / 编辑器垃圾 =====
.DS_Store
Thumbs.db

# ===== 个人 WorkBuddy 数据（若在子目录出现） =====
.workbuddy/

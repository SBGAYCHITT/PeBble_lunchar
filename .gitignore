# ===== 依赖（npm install 自动生成，约 441MB，绝不传） =====
node_modules/

# ===== 构建产物（npm run dist 生成，约 334MB；SignPath 从本地 zip 签名，不进仓库） =====
dist/
# 备用输出目录：electron-builder 的 emptyDir 会被沙箱的批量删除守卫拦（>50 项），
# 这时改用 --config.directories.output=distN 重建，再 PL_SRC=distN/win-unpacked 打包
dist*/

# ===== 本地开发证书配置（含本机证书指纹/路径，不进公开仓库） =====
.signing/

# ===== NSIS 脚本：由 make-exe.js 从 package.json 现生成，版本号/OutFile 路径都是本机的 =====
tools/pl.nsi

# ===== Lite 版前端入口：由 scripts/make-lite.js 从 index.html 现裁，不进仓库（避免与真源漂移） =====
index.lite.html
build/lite/
# ===== Lite 版 Electron 运行时：由 scripts/make-lite-dist.js 从 node_modules 现裁（约 160MB） =====
build/electron-lite/
# 上面那个脚本的重建标记（放在 build/ 根，免得被打进安装包）
build/.lite-dist-stamp.json

# ===== 临时 / 调试产物 =====
*.bak
auto-test-log*.txt
javaprobe.txt
_pages_keys.json
shot-*.png

# ===== 日志 =====
*.log

# ===== 系统 / 编辑器垃圾 =====
.DS_Store
Thumbs.db

# ===== 个人 WorkBuddy 数据（若在子目录出现） =====
.workbuddy/
